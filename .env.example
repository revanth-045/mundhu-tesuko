# Any OpenAI-compatible endpoint works. Two supported setups:
#
# 1. OpenAI
#    OPENAI_API_KEY=sk-...
#    (leave OPENAI_BASE_URL unset; OPENAI_MODEL defaults to gpt-4o-mini)
#
# 2. Google Gemini via its OpenAI-compatible layer (has a free tier)
#    OPENAI_API_KEY=<your Gemini key>
#    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#    OPENAI_MODEL=gemini-2.5-flash
#
# The app runs without a key: cached answers, eligibility, retrieval, the prune
# and the appeal letter are all local. Only novel questions need the model.

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=low
